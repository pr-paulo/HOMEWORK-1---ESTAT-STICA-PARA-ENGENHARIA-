# Calculo dos quartis (Q1,Q2 e Q3) e do intervalo interquartil para 10 amostras [1,10].
# A variável numérica relevante escolhida foi total_user.

# Calculo dos quartis para 10 amostras.
total_user_Q1_10 <- quantile(data_group$total_user[1:10], 0.25, na.rm = TRUE) # 1º Quartil (25%)
total_user_Q2_10 <- quantile(data_group$total_user[1:10], 0.50, na.rm = TRUE) # 2º Quartil (Mediana - 50%)
total_user_Q3_10 <- quantile(data_group$total_user[1:10], 0.75, na.rm = TRUE) # 3º Quartil (75%)

# Intervalo Interquartil para 10 amostras.
total_user_IQR_10 <- IQR(data_group$total_user[1:10], na.rm = TRUE)

tabela_dos_quartis_para_10_amostras <- data.frame(
  Medida = c("Q1 (25%)", "Q2 (Mediana - 50%)", "Q3 (75%)", "IQR"),
  Valor = c(total_user_Q1_10, total_user_Q2_10, total_user_Q3_10, total_user_IQR_10)
)

print(tabela_dos_quartis_para_10_amostras)

# Calculo dos Outliners para as 10 amostras.

limite_inferior_10 <- total_user_Q1_10 - 1.5 * total_user_IQR_10
limite_superior_10 <- total_user_Q3_10 + 1.5 * total_user_IQR_10

outliers_para_as_10 <- data_group[1:10,][data_group$total_user[1:10] < limite_inferior_10 | data_group$total_user[1:10] > limite_superior_10, ]

tabela_dos_bigodes_para_10 <- data.frame(
  Medida = c("Limite Inferior", "Limite Superior"),
  Valor = c(limite_inferior_10, limite_superior_10)
)

print(tabela_dos_bigodes_para_10)

